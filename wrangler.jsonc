{
  "name": "xx-v6",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  // keep variables added in the Cloudflare dashboard when a new build deploys
  "keep_vars": true,
  // run_worker_first: every request (pages + data files) goes through the password gate in src/worker.js
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true }
}
